{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "4.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icon128-96.png",
    "48": "icon128-96.png",
    "128": "icon128-96.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
